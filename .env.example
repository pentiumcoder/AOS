# mock runs fully offline with scripted model responses; live calls the providers in config/models.yaml
LLM_MODE=mock
# live mode defaults to a local Ollama server (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
# services uses Postgres/Redis from docker-compose; memory uses SQLite and fakeredis
STORAGE_MODE=services
# celery hands runs to the worker; inline runs them inside the API process
TASK_EXECUTION=celery

DATABASE_URL=postgresql+psycopg://aos:aos@localhost:5433/aos
REDIS_URL=redis://localhost:6380/0
CHROMA_HOST=localhost
CHROMA_PORT=8001

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_REVIEWER_MODEL=
TAVILY_API_KEY=

# hash works offline; ollama uses EMBEDDING_MODEL (e.g. nomic-embed-text) on the local server
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
# optional URL that receives a JSON POST for every escalation
NOTIFY_WEBHOOK_URL=

WORKSPACE_DIR=
MCP_ENABLED=true
LOG_LEVEL=INFO
